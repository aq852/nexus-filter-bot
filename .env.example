# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Your numeric Telegram user ID. This account owns all management commands.
OWNER_ID=

# MongoDB connection string for the indexed library and bot settings.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telegram_autofilter

# Optional: users must be a member of this channel before private file delivery.
FORCE_SUB_CHANNEL_ID=

# Optional: delete each group search result after this many seconds (0 disables it).
AUTO_DELETE_SECONDS=0

# Timezone for scheduled broadcasts.
TIMEZONE=Asia/Kolkata

# Optional owner upload inbox: private files sent by OWNER_ID are copied here and indexed.
# The bot must be an administrator in this channel.
STORAGE_CHANNEL_ID=

# Optional public/updates channel. The bot posts one announcement for every newly indexed file.
UPDATES_CHANNEL_ID=
