# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Your numeric Telegram user ID. This account owns all management commands.
OWNER_ID=

# MongoDB connection string for the indexed library and bot settings.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telegram_autofilter

# Optional: users must be a member of this channel before private file delivery.
FORCE_SUB_CHANNEL_ID=
